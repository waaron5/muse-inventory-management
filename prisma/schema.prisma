// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum InventoryStatus {
  ACTIVE
  RETIRED
}

enum GiftStatus {
  ACTIVE
  CONSUMED
}

enum InventoryReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  COMPLETED
}

enum GiftReservationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AuditEntityType {
  INVENTORY_ITEM
  EVENT
  INVENTORY_RESERVATION
  GIFT_ITEM
  GIFT_RESERVATION
  USER
}

enum AuditActionType {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  RETURNED
  RETIRED
  DELETED
  CONSUMED
  QUANTITY_ADJUSTED
  CANCELED
  ACTIVATED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryReservationsRequested InventoryReservation[] @relation("RequestedByUser")
  inventoryReservationsApproved  InventoryReservation[] @relation("ApprovedByUser")
  inventoryReservationsModified  InventoryReservation[] @relation("ModifiedByUser")

  giftReservationsRequested GiftReservation[] @relation("GiftRequestedByUser")
  giftReservationsApproved  GiftReservation[] @relation("GiftApprovedByUser")
  giftReservationsModified  GiftReservation[] @relation("GiftModifiedByUser")

  inventoryCreated InventoryItem[] @relation("InventoryCreatedBy")
  inventoryUpdated InventoryItem[] @relation("InventoryUpdatedBy")

  giftsCreated GiftItem[] @relation("GiftCreatedBy")
  giftsUpdated GiftItem[] @relation("GiftUpdatedBy")

  eventsCreated Event[] @relation("EventCreatedBy")
  eventsUpdated Event[] @relation("EventUpdatedBy")

  auditLogs AuditLog[]
}

model InventoryItem {
  id              String          @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  quantity        Int             @default(0)
  currentLocation String?
  status          InventoryStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])

  reservations InventoryReservation[]
}

model GiftItem {
  id          String     @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  quantity    Int        @default(0)
  status      GiftStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("GiftCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("GiftUpdatedBy", fields: [updatedById], references: [id])

  reservations GiftReservation[]
}

model Event {
  id          String   @id @default(cuid())
  companyName String
  eventName   String
  location    String
  startDate   DateTime
  endDate     DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("EventUpdatedBy", fields: [updatedById], references: [id])

  inventoryReservations InventoryReservation[]
  giftReservations      GiftReservation[]
}

model InventoryReservation {
  id             String                     @id @default(cuid())
  quantity       Int
  status         InventoryReservationStatus @default(PENDING)
  returnLocation String?
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  inventoryItemId  String
  eventId          String
  requestedById    String
  approvedById     String?
  lastModifiedById String?

  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id])
  event          Event         @relation(fields: [eventId], references: [id])
  requestedBy    User          @relation("RequestedByUser", fields: [requestedById], references: [id])
  approvedBy     User?         @relation("ApprovedByUser", fields: [approvedById], references: [id])
  lastModifiedBy User?         @relation("ModifiedByUser", fields: [lastModifiedById], references: [id])
}

model GiftReservation {
  id        String                @id @default(cuid())
  quantity  Int
  status    GiftReservationStatus @default(PENDING)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  giftItemId       String
  eventId          String
  requestedById    String
  approvedById     String?
  lastModifiedById String?

  giftItem       GiftItem @relation(fields: [giftItemId], references: [id])
  event          Event    @relation(fields: [eventId], references: [id])
  requestedBy    User     @relation("GiftRequestedByUser", fields: [requestedById], references: [id])
  approvedBy     User?    @relation("GiftApprovedByUser", fields: [approvedById], references: [id])
  lastModifiedBy User?    @relation("GiftModifiedByUser", fields: [lastModifiedById], references: [id])
}

model AuditLog {
  id           String          @id @default(cuid())
  entityType   AuditEntityType
  entityId     String
  actionType   AuditActionType
  summary      String
  metadataJson String?
  timestamp    DateTime        @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([timestamp])
}
