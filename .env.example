# Neon (set by the Vercel Marketplace integration; pull locally with `vercel env pull`)
# Use sslmode=verify-full in both URLs to keep certificate and hostname verification explicit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sentry (production only; the DSN is public by design)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Photos: the private Blob store muse-inventory-photos (set when the store was
# connected; pull locally with `vercel env pull`).
BLOB_READ_WRITE_TOKEN=

# Guards /api/sentry-check and /api/give-away (Vercel Cron sends it)
CRON_SECRET=

# Sign in by emailed code (ADR 0008). Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Optional: worked out from Vercel's own variables when unset.
BETTER_AUTH_URL=
# Without a key, codes go to the console and .outbox/mail.jsonl instead.
RESEND_API_KEY=
# Where Report a bug sends to: the maintainer, never an Admin.
MAINTAINER_EMAIL=
# Defaults to Muse Inventory <no-reply@inventory.museem.com>; verify that domain
# in Resend before sending. Override only with another verified sender.
MAIL_FROM=
