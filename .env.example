# Neon on Vercel (set by the Neon integration; use sslmode=verify-full in both URLs).
# Locally, never Neon: with no Resend key, invites and codes only reach the outbox,
# so real people would be added but never emailed. Use the muse_dev database in the
# muse-e2e Docker container, then `pnpm admin:create` yourself into it.
DATABASE_URL=postgres://postgres@localhost:5433/muse_dev
DATABASE_URL_UNPOOLED=postgres://postgres@localhost:5433/muse_dev

# Sentry (production only; the DSN is public by design)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Photos: private Blob stores, each set when it was connected to the project.
# Production uses muse-inventory-photos; Preview and Development use
# muse-inventory-photos-preview, so a photo sent from a preview or from here never
# lands beside Muse's. Copy only this line from the Development variables:
# `vercel env pull` would also bring Neon's DATABASE_URL.
BLOB_READ_WRITE_TOKEN=

# Guards /api/sentry-check and /api/give-away (Vercel Cron sends it)
CRON_SECRET=

# Sign in by emailed code (ADR 0008). Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Optional: worked out from Vercel's own variables when unset.
BETTER_AUTH_URL=
# Without a key, codes and invites go to the console and .outbox/mail.jsonl
# instead, and sign-in and Invite say so.
RESEND_API_KEY=
# Where Report a bug sends to: the maintainer, never an Admin.
MAINTAINER_EMAIL=
# Defaults to Muse Inventory <no-reply@inventory.museem.com>; verify that domain
# in Resend before sending. Override only with another verified sender.
MAIL_FROM=
