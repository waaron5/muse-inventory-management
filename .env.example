DATABASE_URL="postgresql://muse:muse_password@localhost:5433/muse_db?schema=public"
NEXTAUTH_SECRET="<generate-a-random-secret>"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For Vercel project settings, enter raw values without surrounding quotes and
# without the `KEY=` prefix. `DATABASE_URL` must start with `postgres://` or
# `postgresql://`.

# App mode: "production" (default) or "demo"
# APP_MODE="production"

# Secret for the demo reset API endpoint (only needed when APP_MODE=demo)
# Do not set this for production unless you are intentionally running a demo environment.
# DEMO_RESET_SECRET="generate-a-random-secret"

# Email notifications (Resend — add a verified sender at resend.com/domains)
RESEND_API_KEY="re_your_key_here"
RESEND_FROM_EMAIL="notifications@yourdomain.com"

# Vercel Blob uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# One-time production admin bootstrap only.
# Set these temporarily when running `npm run admin create`, then remove them.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="generate-a-strong-password"
ADMIN_NAME="Muse Admin"
